  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "POST User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = pm.iterationData.get(\"email\") || \"demo@example.com\";\r",
                  "pm.variables.set(\"uniqueEmail\", Date.now() + \"_\" + email);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 201 Created\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "const json = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Response có id kiểu number\", function () {\r",
                  "    pm.expect(json.id).to.be.a(\"number\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Dữ liệu trả về khớp với dòng CSV\", function () {\r",
                  "    pm.expect(json.name).to.eql(pm.iterationData.get(\"name\"));\r",
                  "    pm.expect(json.gender).to.eql(pm.iterationData.get(\"gender\"));\r",
                  "    pm.expect(json.status).to.eql(pm.iterationData.get(\"status\"));\r",
                  "});\r",
                  "\r",
                  "// API Chaining: lưu id và email để request sau dùng\r",
                  "pm.collectionVariables.set(\"userId\", json.id);\r",
                  "pm.collectionVariables.set(\"userEmail\", json.email);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{name}}\",\r\n  \"gender\": \"{{gender}}\",\r\n  \"email\": \"{{uniqueEmail}}\",\r\n  \"status\": \"{{status}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"ID khớp với user vừa tạo\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "    pm.expect(String(json.id)).to.eql(String(pm.collectionVariables.get(\"userId\")));\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
