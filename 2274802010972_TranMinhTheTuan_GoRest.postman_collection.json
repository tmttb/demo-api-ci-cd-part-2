        {
          "name": "POST trùng email",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({\r",
                  "    url: pm.variables.get(\"baseUrl\") + \"/users\",\r",
                  "    method: \"POST\",\r",
                  "    header: {\r",
                  "        \"Authorization\": \"Bearer \" + pm.environment.get(\"token\"),\r",
                  "        \"Content-Type\": \"application/json\"\r",
                  "    },\r",
                  "    body: {\r",
                  "        mode: \"raw\",\r",
                  "        raw: JSON.stringify({\r",
                  "            name: \"Seed User\",\r",
                  "            gender: \"male\",\r",
                  "            email: pm.collectionVariables.get(\"userEmail\"),\r",
                  "            status: \"active\"\r",
                  "        })\r",
                  "    }\r",
                  "}, function (err, res) {\r",
                  "    if (!err && res.code === 201) {\r",
                  "        pm.collectionVariables.set(\"seedId\", res.json().id);\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 422 Unprocessable Entity\", function () {\r",
                  "    pm.response.to.have.status(422);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Lỗi nằm ở field email và báo đã tồn tại\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "    pm.expect(json[0].field).to.eql(\"email\");\r",
                  "    pm.expect(json[0].message).to.include(\"taken\");\r",
                  "});\r",
                  "\r",
                  "// Dọn user mồi\r",
                  "pm.sendRequest({\r",
                  "    url: pm.variables.get(\"baseUrl\") + \"/users/\" + pm.collectionVariables.get(\"seedId\"),\r",
                  "    method: \"DELETE\",\r",
                  "    header: { \"Authorization\": \"Bearer \" + pm.environment.get(\"token\") }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
